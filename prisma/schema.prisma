generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String?            @unique
  phone             String?            @unique
  password          String
  name              String
  zipcode           String?            // 停電アラート対象エリアの郵便番号(数字7桁, 正規化済み)
  outageAlert       Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  cats              Cat[]
  feedingLogs       FeedingLog[]
  toiletLogs        ToiletLog[]
  weightLogs        WeightLog[]
  medicationLogs    MedicationLog[]
  careLogs          CareLog[]
  invitesCreated    InviteCode[]       @relation("InviteCreated")
  invitesUsed       InviteCode[]       @relation("InviteUsed")
  pushSubscriptions PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// 停電の「新規発生」を判定するためのエリア状態。areaKey は正規化郵便番号。
model OutageState {
  areaKey   String   @id
  active    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique
  catId       String
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?
  cat         Cat       @relation(fields: [catId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("InviteCreated", fields: [createdById], references: [id])
  usedBy      User?     @relation("InviteUsed", fields: [usedById], references: [id])
  createdAt   DateTime  @default(now())
}

model Cat {
  id              String          @id @default(cuid())
  name            String
  photo           String?
  birthday        DateTime?
  breed           String?
  careCycles      Json?           // per-item care interval overrides, keyed by care item name
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  users           User[]
  inviteCodes     InviteCode[]
  feedingLogs     FeedingLog[]
  toiletLogs      ToiletLog[]
  weightLogs      WeightLog[]
  medicationLogs  MedicationLog[]
  careLogs        CareLog[]
}

model FeedingLog {
  id        String   @id @default(cuid())
  catId     String
  userId    String
  foodType  String?
  amount    Float
  fedAt     DateTime
  note      String?
  cat       Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model ToiletLog {
  id        String   @id @default(cuid())
  catId     String
  userId    String
  type      String
  count     Int      @default(1)
  condition String?
  loggedAt  DateTime
  cat       Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model WeightLog {
  id         String   @id @default(cuid())
  catId      String
  userId     String
  weight     Float
  measuredAt DateTime
  note       String?
  cat        Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

model MedicationLog {
  id        String   @id @default(cuid())
  catId     String
  userId    String
  name      String
  dosage    String?
  givenAt   DateTime
  note      String?
  cat       Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model CareLog {
  id        String   @id @default(cuid())
  catId     String
  userId    String
  type      String
  doneAt    DateTime
  note      String?
  cat       Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}
