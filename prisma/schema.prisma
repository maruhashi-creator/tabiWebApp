generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  password    String
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  feedingLogs FeedingLog[]
  toiletLogs  ToiletLog[]
  weightLogs  WeightLog[]
}

model Cat {
  id          String       @id @default(cuid())
  name        String
  birthday    DateTime?
  breed       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  feedingLogs FeedingLog[]
  toiletLogs  ToiletLog[]
  weightLogs  WeightLog[]
}

model FeedingLog {
  id        String   @id @default(cuid())
  catId     String
  userId    String
  foodType  String?
  amount    Float
  fedAt     DateTime
  note      String?
  cat       Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model ToiletLog {
  id        String   @id @default(cuid())
  catId     String
  userId    String
  type      String
  count     Int      @default(1)
  condition String?
  loggedAt  DateTime
  cat       Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model WeightLog {
  id         String   @id @default(cuid())
  catId      String
  userId     String
  weight     Float
  measuredAt DateTime
  note       String?
  cat        Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}
